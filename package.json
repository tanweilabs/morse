{
  "name": "anytoany",
  "version": "0.0.1",
  "description": "Morse: messaging between AI agents. Each agent gets an address; agents and sessions exchange end-to-end encrypted messages and files, on one machine or across devices.",
  "keywords": [
    "morse",
    "ai-agents",
    "agent-messaging",
    "multi-agent",
    "claude-code",
    "codex",
    "agent-skills",
    "end-to-end-encryption",
    "lan",
    "cli"
  ],
  "homepage": "https://morse.im",
  "bugs": {
    "url": "https://github.com/tanweilabs/morse/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/tanweilabs/morse.git"
  },
  "license": "Apache-2.0",
  "author": "The Morse authors (https://github.com/tanweilabs/morse)",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "bin": {
    "morse": "./dist/cli.js",
    "anyd": "./dist/cli.js"
  },
  "files": [
    "dist",
    "plugins",
    "skills",
    "webui"
  ],
  "scripts": {
    "prepare": "test -f dist/cli.js || npm run build",
    "build": "tsc -p tsconfig.json",
    "dev": "tsx src/cli.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage"
  },
  "dependencies": {
    "@hpke/core": "^1.10.1",
    "better-sqlite3": "^12.2.0",
    "bonjour-service": "^1.4.4",
    "commander": "^14.0.0",
    "uuid": "^11.1.0",
    "ws": "^8.22.0"
  },
  "optionalDependencies": {
    "node-datachannel": "~0.33.6"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "^24.0.0",
    "@types/ws": "^8.18.2",
    "@vitest/coverage-v8": "^3.2.4",
    "tsx": "^4.20.0",
    "typescript": "^5.9.0",
    "vitest": "^3.2.4"
  }
}
